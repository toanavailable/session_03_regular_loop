<mxfile><diagram name="Mindmap"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="root" value="Python Session 3&lt;br&gt;Vòng lặp cơ bản" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3a5f;fontColor=#ffffff;strokeColor=#1f3a5f;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="967" y="883" width="224" height="72" as="geometry"/></mxCell><mxCell id="l0" value="01. Tư duy lặp (vì sao cần loop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1248" y="718" width="263" height="36" as="geometry"/></mxCell><mxCell id="el0" style="endArrow=none;curved=1;strokeColor=#6c8ebf;strokeWidth=3;" edge="1" parent="1" source="root" target="l0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l0_0" value="Lặp lại một việc nhiều lần mà không chép code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1802" y="778" width="343" height="36" as="geometry"/></mxCell><mxCell id="el0_0" style="endArrow=none;curved=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="l0" target="l0_0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l0_1" value="Code ngắn, dễ sửa: đổi 1 chỗ thay vì 100 chỗ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1743" y="541" width="329" height="36" as="geometry"/></mxCell><mxCell id="el0_1" style="endArrow=none;curved=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="l0" target="l0_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l0_2" value="Xác định: lặp cái gì? bao nhiêu lần? khi nào dừng?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1599" y="331" width="360" height="36" as="geometry"/></mxCell><mxCell id="el0_2" style="endArrow=none;curved=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="l0" target="l0_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l0_3" value="Ứng dụng: duyệt danh sách, tính tổng, nhập lại khi sai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1405" y="163" width="390" height="36" as="geometry"/></mxCell><mxCell id="el0_3" style="endArrow=none;curved=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="l0" target="l0_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1" value="02. Vòng lặp for và range()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="893" y="556" width="228" height="36" as="geometry"/></mxCell><mxCell id="el1" style="endArrow=none;curved=1;strokeColor=#82b366;strokeWidth=3;" edge="1" parent="1" source="root" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1_0" value="for bien in day: duyệt lần lượt từng phần tử" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1225" y="50" width="313" height="36" as="geometry"/></mxCell><mxCell id="el1_0" style="endArrow=none;curved=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="l1" target="l1_0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1_1" value="range(n): 0 → n-1 (không gồm n)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1018" y="0" width="244" height="36" as="geometry"/></mxCell><mxCell id="el1_1" style="endArrow=none;curved=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="l1" target="l1_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1_2" value="range(a, b): a → b-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="17" width="159" height="36" as="geometry"/></mxCell><mxCell id="el1_2" style="endArrow=none;curved=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="l1" target="l1_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1_3" value="range(a, b, step): bước nhảy; step âm để đếm ngược" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="474" y="99" width="379" height="36" as="geometry"/></mxCell><mxCell id="el1_3" style="endArrow=none;curved=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="l1" target="l1_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1_4" value="Duyệt chuỗi: for ch in &quot;Python&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="347" y="241" width="231" height="36" as="geometry"/></mxCell><mxCell id="el1_4" style="endArrow=none;curved=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="l1" target="l1_4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2" value="03. Vòng lặp while" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="644" y="901" width="165" height="36" as="geometry"/></mxCell><mxCell id="el2" style="endArrow=none;curved=1;strokeColor=#d6b656;strokeWidth=3;" edge="1" parent="1" source="root" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2_0" value="while điều_kiện: lặp khi điều kiện còn True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="153" y="432" width="308" height="36" as="geometry"/></mxCell><mxCell id="el2_0" style="endArrow=none;curved=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="l2" target="l2_0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2_1" value="Kiểm tra điều kiện TRƯỚC mỗi lần lặp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="68" y="657" width="281" height="36" as="geometry"/></mxCell><mxCell id="el2_1" style="endArrow=none;curved=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="l2" target="l2_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2_2" value="Phải cập nhật biến điều kiện trong thân vòng lặp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="901" width="351" height="36" as="geometry"/></mxCell><mxCell id="el2_2" style="endArrow=none;curved=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="l2" target="l2_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2_3" value="break: thoát vòng lặp; continue: bỏ qua lượt hiện tại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="21" y="1145" width="376" height="36" as="geometry"/></mxCell><mxCell id="el2_3" style="endArrow=none;curved=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="l2" target="l2_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2_4" value="while True + break: lặp đến khi nhập đúng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="152" y="1370" width="309" height="36" as="geometry"/></mxCell><mxCell id="el2_4" style="endArrow=none;curved=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="l2" target="l2_4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l3" value="04. So sánh for vs while" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="858" y="1233" width="204" height="36" as="geometry"/></mxCell><mxCell id="el3" style="endArrow=none;curved=1;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1" source="root" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l3_0" value="for: biết trước số lần lặp / duyệt dãy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="329" y="1561" width="267" height="36" as="geometry"/></mxCell><mxCell id="el3_0" style="endArrow=none;curved=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="l3" target="l3_0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l3_1" value="while: chưa biết số lần, lặp theo điều kiện" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="486" y="1701" width="306" height="36" as="geometry"/></mxCell><mxCell id="el3_1" style="endArrow=none;curved=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="l3" target="l3_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l3_2" value="for tự tăng biến đếm; while phải tự cập nhật" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="681" y="1782" width="321" height="36" as="geometry"/></mxCell><mxCell id="el3_2" style="endArrow=none;curved=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="l3" target="l3_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l3_3" value="Mọi for đều viết được bằng while, chọn cái dễ đọc hơn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="1806" width="388" height="36" as="geometry"/></mxCell><mxCell id="el3_3" style="endArrow=none;curved=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="l3" target="l3_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l4" value="05. Lỗi thường gặp khi dùng loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1214" y="1123" width="276" height="36" as="geometry"/></mxCell><mxCell id="el4" style="endArrow=none;curved=1;strokeColor=#9673a6;strokeWidth=3;" edge="1" parent="1" source="root" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l4_0" value="Lệch 1 (off-by-one): nhầm range(1, n) với range(1, n+1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1204" y="1754" width="401" height="36" as="geometry"/></mxCell><mxCell id="el4_0" style="endArrow=none;curved=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="l4" target="l4_0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l4_1" value="Lặp vô hạn: quên cập nhật biến (i += 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1451" y="1639" width="297" height="36" as="geometry"/></mxCell><mxCell id="el4_1" style="endArrow=none;curved=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="l4" target="l4_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l4_2" value="Thụt lề sai: lệnh nằm trong/ngoài vòng lặp nhầm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1603" y="1471" width="352" height="36" as="geometry"/></mxCell><mxCell id="el4_2" style="endArrow=none;curved=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="l4" target="l4_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l4_3" value="Khởi tạo biến tổng bên trong vòng lặp → bị reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1732" y="1261" width="350" height="36" as="geometry"/></mxCell><mxCell id="el4_3" style="endArrow=none;curved=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="l4" target="l4_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l4_4" value="Sửa danh sách khi đang duyệt chính nó" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1829" y="1024" width="289" height="36" as="geometry"/></mxCell><mxCell id="el4_4" style="endArrow=none;curved=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="l4" target="l4_4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>